# Writes OUTPUT: a C++ source holding every DATA_DIR/*.json as a byte
# array, plus a name -> bytes table read by src/catalog.cpp.
# Byte arrays (not string literals) keep MSVC's literal limits out of
# the way and survive any character in the data.

file(GLOB _files ${DATA_DIR}/*.json)
list(SORT _files)

set(_body "// Generated by cmake/EmbedData.cmake — do not edit.\n#include <cstddef>\n\nnamespace dhun::catalog::detail {\n\nstruct Entry {\n    const char* name;\n    const unsigned char* data;\n    std::size_t size;\n};\n\n")
set(_table "")
set(_count 0)

foreach(_file ${_files})
    get_filename_component(_name ${_file} NAME_WE)
    string(MAKE_C_IDENTIFIER ${_name} _id)
    file(READ ${_file} _hex HEX)
    string(LENGTH "${_hex}" _hexlen)
    math(EXPR _size "${_hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    # wrap lines every 32 bytes for readable diffs of the generated file
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n    " _bytes "${_bytes}")
    string(APPEND _body "static const unsigned char k_${_id}[] = {\n    ${_bytes}0x00\n};\n\n")
    string(APPEND _table "    {\"${_name}\", k_${_id}, ${_size}},\n")
    math(EXPR _count "${_count} + 1")
endforeach()

string(APPEND _body "extern const Entry kEntries[] = {\n${_table}};\nextern const std::size_t kEntryCount = ${_count};\n\n}  // namespace dhun::catalog::detail\n")

file(WRITE ${OUTPUT}.tmp "${_body}")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)
