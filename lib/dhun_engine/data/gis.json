  },
  {
   "id": "p3",
   "name": "Built Using Low-Impact Materials",
   "category": "Built & Materials",
   "description": "Stabilized rammed earth, stone masonry, lime plaster, non-toxic localized materials."
  },
  {
   "id": "p4",
   "name": "Natural Food",
   "category": "Ecological",
   "description": "Regenerative agroforestry, organic farm-to-table nutrition, indigenous cropping systems."
  },
  {
   "id": "p5",
   "name": "Regenerative Ecosystem",
   "category": "Ecological",
   "description": "Restoring degraded semi-arid soils into self-healing Miyawaki forests and biodiverse habitat."
  },
  {
   "id": "p6",
   "name": "Diverse & Intergenerational",
   "category": "Social & Community",
   "description": "Spaces welcoming children, elders, makers, researchers, and artisans."
  },
  {
   "id": "p7",
   "name": "Experimental & Creative",
   "category": "Human Wellbeing",
   "description": "Living laboratory for spatial compute, vernacular craftsmanship, and low-energy cooling."
  },
  {
   "id": "p8",
   "name": "Individual & Social Wellbeing",
   "category": "Human Wellbeing",
   "description": "Active walking landscape, community tables, quiet contemplation courtyards."
  },
  {
   "id": "p9",
   "name": "Contextual Use of Ancient Wisdom",
   "category": "Built & Materials",
   "description": "Stepwell hydrology, wind-scoop courtyards, thermal mass adapted to Rajasthan's climate."
  },
  {
   "id": "p10",
   "name": "Co-Creation with Communities",
   "category": "Social & Community",
   "description": "Participatory stewardship with surrounding Chak Gulabpura villages."
  },
  {
   "id": "p11",
   "name": "Responsible Consumption",
